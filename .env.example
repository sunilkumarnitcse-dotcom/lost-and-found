# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file, and NEVER put a real password here.
# This file has NO real credentials — only placeholders.

# MongoDB Atlas connection string (REQUIRED).
# Create a free cluster at https://www.mongodb.com/atlas, then paste
# your own connection string here. Replace <user>, <password> and <cluster>.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/lostfound

# Port for the web server (optional, default 3000).
PORT=3000

# Demo PINs for Staff / Admin login (DEMO ONLY).
# Change these before any real use. In a real system, use properly
# hashed passwords, not plain PINs (see SRS NFR-03).
STAFF_PIN=staff123
ADMIN_PIN=admin123
